@import url("https://fonts.upset.dev/css2?family=Plus+Jakarta+Sans:wght@200..800&display=swap");
@import url("https://pvinis.github.io/iosevka-webfont/7.0.2/iosevka.css");

:root {
  --bgcolor: #f7fafc;
  --main-color: #0035db;
  --fontsize: 1.1em;
}

::selection {
  color: var(--bgcolor);
  background-color: var(--main-color);
}

body {
  font-family: "Plus Jakarta Sans", system-ui, sans-serif;
  font-size: 1.1rem;
  background-color: var(--bgcolor);
}

.body-container {
  width: min(55ch, 100% - 6ch);
  margin-inline: auto;
  padding-inline: 3rem;
  text-align: justify;
  color: var(--main-color);
}

header {
  display: flex;
  flex-wrap: wrap;
  width: 100%;
  place-content: center;
  align-items: center;
  font-family: "Iosevka Web";
}

#header-logo {
  flex: 3;
  font-size: 2rem;
}

#header-side {
  flex: 2;
  font-size: smaller;
  /* border-left: 2px solid; */
  padding-left: 2rem;
  text-align: end;
}

nav {
  display: flex;
  flex-wrap: wrap;
  border-top: 2px solid;
}

nav a {
  flex: 1;
  text-align: center;
  font-family: "Iosevka Web";
  font-weight: normal;
  padding-block: 0.5rem;
  padding-inline: 1rem;
}

main {
  border-top: 2px solid;
  border-bottom: 2px solid;
  & p {
    /* text-indent: 4ch; */
  }
}

.info {
  text-indent: none;
  font-size: smaller;
  text-decoration: underline;
  margin-top: -1.5em;
}

a {
  font-weight: bold;
  color: var(--main-color);
  text-decoration: underline;
  transition-property: color, background, text-decoration-color, font-weight;
  transition-duration: 0.15s;
  &:hover {
    color: var(--bgcolor);
    background: var(--main-color);
    text-decoration-color: var(--main-color);
    font-weight: bold;
  }
}

p {
  line-height: 1.5;
}

footer {
  font-size: 0.85rem;
  & p {
    line-height: 0.3;
  }
}
